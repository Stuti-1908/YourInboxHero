# YourInboxHero Environment Configuration
# ==========================================
# Copy this file to .env and fill in real values. Never commit .env itself.

# REQUIRED in production: must be exactly "production" (not "prod", not unset).
# This single flag controls several safety behaviors:
#   - Hides interactive API docs (/docs, /openapi.json)
#   - Enables validate_production_settings() at startup, which refuses to
#     boot if SECRET_KEY/DATABASE_URL/RESEND_API_KEY/CORS_ORIGINS still look
#     like dev defaults
#   - Disables the dev-only seeded admin/admin user and Base.metadata.create_all()
# For local dev, leave this unset (defaults to "development").
ENVIRONMENT=production

# REQUIRED: JWT Secret for signing access tokens (generate with: openssl rand -hex 32)
# In production, this MUST be set - no fallback allowed.
# For local dev, leave this line commented out (not "SECRET_KEY=" with a
# blank value — pydantic-settings treats an explicit empty string as SET,
# which breaks the dev fallback). Fill in a real value before deploying.
SECRET_KEY=

# REQUIRED in production: PostgreSQL connection string.
# Same rule as above: for local dev, comment this line out entirely rather
# than leaving it blank, so it falls back to SQLite (local.db).
DATABASE_URL=

# REQUIRED in production: key used to encrypt stored secrets we must later
# decrypt ourselves (currently: customer SMTP passwords). NOT for user
# account passwords, which stay one-way hashed separately. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every already-encrypted value permanently
# undecryptable — back it up the same way you would SECRET_KEY. For local
# dev, leave this line commented out entirely (same empty-string caveat as
# SECRET_KEY above) unless you're testing the SMTP-password feature.
ENCRYPTION_KEY=

# GoHighLevel API (Internal — powers SMS & Voice escalation)
GHL_API_KEY=
GHL_LOCATION_ID=

# REQUIRED in production: Resend (Fallback email sender when user has no custom SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=reminders@yourinboxhero.com

# REQUIRED in production: base URL of the deployed frontend, used to build
# links sent in emails (currently: the email-verification link).
FRONTEND_URL=https://yourinboxhero.com

# Stripe (payment/subscription processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Redirect targets after Stripe Checkout — point these at the production frontend
STRIPE_SUCCESS_URL=https://yourinboxhero.com/payment-success
STRIPE_CANCEL_URL=https://yourinboxhero.com/
# Price IDs from the Stripe Dashboard (Products > Pricing) — one recurring
# monthly price per plan, matching the advertised amount exactly
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# REQUIRED in production: comma-separated list is not supported here — this
# is a JSON list via pydantic-settings, e.g.:
# CORS_ORIGINS=["https://yourinboxhero.com","https://www.yourinboxhero.com"]
CORS_ORIGINS=["https://yourinboxhero.com","https://www.yourinboxhero.com"]

# Registration normally requires a completed Stripe payment. These two
# settings are bypasses for accounts that shouldn't have to pay:
# - ADMIN_EMAILS: comma-separated exact emails (e.g. you, support staff)
# - TEST_INVITE_CODE: one shared secret you hand out to testers/colleagues
#   instead of adding each of their emails individually. Leave unset to
#   disable this bypass entirely (an unset code never matches, even an
#   empty submission). Rotate it if it leaks.
ADMIN_EMAILS=
TEST_INVITE_CODE=

# Sentry error tracking (Optional but strongly recommended in production —
# without it, crashes and scheduler/webhook failures are invisible until a
# customer complains). Get a DSN from sentry.io (free tier) under a Python/
# FastAPI project. Leaving this unset disables Sentry entirely (no-op, no
# network calls) — safe to leave blank in local dev.
SENTRY_DSN=

# Azure Application Insights (Optional — production monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Feature flags via Unleash (Optional — if unset, reminders-enabled defaults to ON)
UNLEASH_URL=

# Azure Service Bus (Deprecated — no longer used; reminders now send directly)
# SERVICE_BUS_CONNECTION_STRING=
