# YourInboxHero Environment Configuration
# ==========================================

# REQUIRED: JWT Secret for signing access tokens (generate with: openssl rand -hex 32)
# In production, this MUST be set - no fallback allowed
SECRET_KEY=

# REQUIRED in production: PostgreSQL connection string
# Local dev defaults to SQLite (local.db) if unset
DATABASE_URL=

# GoHighLevel API (Internal — powers SMS & Voice escalation)
GHL_API_KEY=
GHL_LOCATION_ID=UrEcKwN0088GKPuJlkcS

# REQUIRED in production: Resend (Fallback email sender when user has no custom SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=reminders@yourinboxhero.com

# Stripe (payment/subscription processing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Redirect targets after Stripe Checkout — point these at the production frontend
STRIPE_SUCCESS_URL=https://yourinboxhero.com/payment-success
STRIPE_CANCEL_URL=https://yourinboxhero.com/
# Price IDs from the Stripe Dashboard (Products > Pricing) — one recurring
# monthly price per plan, matching the advertised amount exactly
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# REQUIRED in production: comma-separated list is not supported here — this
# is a JSON list via pydantic-settings, e.g.:
# CORS_ORIGINS=["https://yourinboxhero.com","https://www.yourinboxhero.com"]
CORS_ORIGINS=["https://yourinboxhero.com","https://www.yourinboxhero.com"]

# Azure Application Insights (Optional — production monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Feature flags via Unleash (Optional — if unset, reminders-enabled defaults to ON)
UNLEASH_URL=

# Azure Service Bus (Deprecated — no longer used; reminders now send directly)
# SERVICE_BUS_CONNECTION_STRING=
